  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "let jsonData = {};\r",
          "\r",
          "try {\r",
          "    jsonData = pm.response.json();\r",
          "} catch (e) {\r",
          "    console.log(\"Response is not JSON\");\r",
          "}\r",
          "\r",
          "// ===============================\r",
          "// Access Token\r",
          "// ===============================\r",
          "if (jsonData.access_token) {\r",
          "    pm.environment.set(\"access_token\", jsonData.access_token);\r",
          "    console.log(\"access_token saved\");\r",
          "}\r",
          "\r",
          "// ===============================\r",
          "// Refresh Token\r",
          "// ===============================\r",
          "if (jsonData.refresh_token) {\r",
          "    pm.environment.set(\"refresh_token\", jsonData.refresh_token);\r",
          "    console.log(\"refresh_token saved\");\r",
          "}\r",
          "\r",
          "// ===============================\r",
          "// Verification Token\r",
          "// ===============================\r",
          "if (jsonData.verification_token) {\r",
          "    pm.environment.set(\r",
          "        \"verification_token\",\r",
          "        jsonData.verification_token\r",
          "    );\r",
          "\r",
          "    console.log(\"verification_token saved\");\r",
          "}\r",
          "\r",
          "// ===============================\r",
          "// Reset Token\r",
          "// ===============================\r",
          "if (jsonData.reset_token) {\r",
          "    pm.environment.set(\r",
          "        \"reset_token\",\r",
          "        jsonData.reset_token\r",
          "    );\r",
          "\r",
          "    console.log(\"reset_token saved\");\r",
          "}\r",
          "\r",
          "// ===============================\r",
          "// Sessions / Device\r",
          "// ===============================\r",
          "if (\r",
          "    jsonData.sessions &&\r",
          "    Array.isArray(jsonData.sessions) &&\r",
          "    jsonData.sessions.length > 0\r",
          ") {\r",
          "    const session = jsonData.sessions[0];\r",
          "\r",
          "    if (session.id) {\r",
          "        pm.environment.set(\"device_id\", session.id);\r",
          "        console.log(\"device_id saved:\", session.id);\r",
          "    }\r",
          "\r",
          "    if (session.device_uuid) {\r",
          "        pm.environment.set(\r",
          "            \"device_uuid\",\r",
          "            session.device_uuid\r",
          "        );\r",
          "\r",
          "        console.log(\r",
          "            \"device_uuid saved:\",\r",
          "            session.device_uuid\r",
          "        );\r",
          "    }\r",
          "}\r",
          "\r",
          "// ===============================\r",
          "// User ID\r",
          "// ===============================\r",
          "if (jsonData.user_id) {\r",
          "    pm.environment.set(\"user_id\", jsonData.user_id);\r",
          "    console.log(\"user_id saved\");\r",
          "}\r",
          "\r",
          "// ===============================\r",
          "// Profile User ID\r",
          "// ===============================\r",
          "if (\r",
          "    jsonData.profile &&\r",
          "    jsonData.profile.id\r",
          ") {\r",
          "    pm.environment.set(\r",
          "        \"user_id\",\r",
          "        jsonData.profile.id\r",
          "    );\r",
          "\r",
          "    console.log(\"user_id saved from profile\");\r",
          "}\r",
          "\r",
          "// ===============================\r",
          "// Request Log\r",
          "// ===============================\r",
          "console.log(\r",
          "    \"Request:\",\r",
          "    pm.request.method,\r",
          "    pm.request.url.toString()\r",
          ");\r",
          "\r",
          "console.log(\r",
          "    \"Status:\",\r",
