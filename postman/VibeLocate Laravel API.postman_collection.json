                  "if (j.access_token) pm.collectionVariables.set('access_token', j.access_token);",
                  "if (j.refresh_token) pm.collectionVariables.set('refresh_token', j.refresh_token);",
                  "if (j.verification_token) pm.collectionVariables.set('verification_token', j.verification_token);",
                  "if (j.reset_token) pm.collectionVariables.set('password_reset_token', j.reset_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
